<?xml version="1.0" encoding="UTF-8"?>

<!-- Configuration PHPUnit autonome pour MikaTestGeneratorBundle -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         colors="true"
         failOnDeprecation="true"
         failOnNotice="true"
         failOnWarning="true"
         bootstrap="vendor/autoload.php"
         cacheDirectory=".phpunit.cache"
>
    <php>
        <ini name="display_errors" value="1" />
        <ini name="error_reporting" value="-1" />
        <server name="APP_ENV" value="test" force="true" />
        <server name="SHELL_VERBOSITY" value="-1" />

        <!-- Déclaration des clés d'API factices pour l'exécution des tests -->
        <env name="OPENAI_API_KEY" value="sk-fake-key-for-tests"/>
        <env name="ANTHROPIC_API_KEY" value="fake-key-for-tests"/>
        <env name="GEMINI_API_KEY" value="fake-key-for-tests"/>
        <env name="OPENROUTER_API_KEY" value="fake-key-for-tests"/>
    </php>

    <testsuites>
        <testsuite name="MikaTestGeneratorBundle Test Suite">
            <directory>tests</directory>
            <!-- Exclusion explicite du dossier des tests temporaires générés -->
            <exclude>tests/Dynamic</exclude>
        </testsuite>
    </testsuites>

    <source ignoreSuppressionOfDeprecations="true"
            ignoreIndirectDeprecations="true"
            restrictNotices="true"
            restrictWarnings="true"
    >
        <include>
            <directory suffix=".php">src</directory>
        </include>
    </source>
</phpunit>